# node-unraid — example environment for real-server e2e tests (READ-ONLY).
# Copy to .env and fill in real values. .env is gitignored and must NEVER be committed.

# Unraid host (WebGUI host that serves /graphql) and port (default 80; use 443 for https).
UNRAID_HOST=
UNRAID_PORT=80
# Set to 'true' if the WebGUI is served over https.
UNRAID_HTTPS=false

# An ADMIN-role API key. Create it on the server with:
#   unraid-api apikey --create     (or Settings -> Management Access -> API Keys)
# Required role: ADMIN (system metrics/info need it).
UNRAID_API_KEY=

# Gate for the real-server e2e suite (READ-ONLY queries only; no control mutations run live).
UNRAID_E2E=0
