{
  "name": "node-unraid",
  "version": "0.0.0",
  "description": "Node.js/TypeScript client for the Unraid GraphQL API (Docker, array, disks, VMs, system, notifications)",
  "license": "MIT",
  "author": "apocaliss92",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apocaliss92/node-unraid.git"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.e2e.config.ts tests/e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "unraid",
    "graphql",
    "docker",
    "homelab",
    "nas",
    "self-hosted"
  ],
  "devDependencies": {
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-codegen/import-types-preset": "^4.0.1",
    "@graphql-codegen/typed-document-node": "^7.0.3",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-graphql-request": "^7.1.0",
    "@graphql-codegen/typescript-operations": "^6.0.3",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.14.1",
    "graphql-request": "^7.4.0",
    "graphql-ws": "^6.0.8",
    "ws": "^8.21.0"
  }
}
